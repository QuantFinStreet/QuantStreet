# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed client origins.
# Include your production client URL alongside localhost when deploying.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# AI Chat (Milestone 2) — required for POST /api/chat and POST /api/openai-chat.
# Without these, chat requests return a typed 503 rather than crashing.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Requests/minute per IP allowed on the chat endpoints (they hit paid APIs).
CHAT_RATE_LIMIT_PER_MINUTE=20
